# ============================================================
# avatar 本地端 — 用户交付专用配置
# 复制本文件为 .env.local 并填入真实值
# ============================================================

# ==================== LLM 配置（必填）====================
# 脚本生成使用，用户自己的 DeepSeek / OpenAI 等 API

LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# token 上限（默认 8192，推理模型建议更高）
LLM_MAX_TOKENS=8192
# 关闭 thinking，避免 DeepSeek v4 推理内容吃满 token
LLM_THINKING_MODE=disabled

# ==================== Relay 视频服务（必填）====================
# 由我们的云端 relay 提供，不需要配置 HeyGen API Key

VIDEO_PROVIDER=relay
RELAY_BASE_URL=https://relay.yourservice.com
RELAY_APP_KEY=your_relay_app_key

# ==================== 本地工具路径（必填）====================
# ffmpeg 用于后处理配乐+字幕
FFMPEG_PATH=C:\path\to\ffmpeg.exe
FFPROBE_PATH=C:\path\to\ffprobe.exe

# ==================== 字幕 AI（可选）====================
# 如果不需要 AI 字幕时间轴，可不配置（自动 fallback 到均匀字幕）
# PYTHON_PATH=C:\path\to\.venv\Scripts\python.exe
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=zh
# WHISPER_MODE=faster_whisper
# WHISPER_FALLBACK_ENABLED=true
