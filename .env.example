# LLM configuration (OpenAI-compatible, e.g. DeepSeek/OpenAI)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_THINKING_MODE=disabled
LLM_REASONING_EFFORT=high

# Video provider: recommended to use relay in production
VIDEO_PROVIDER=relay
RELAY_BASE_URL=http://localhost:8787
RELAY_APP_KEY=dev_key

# Optional direct HeyGen mode (not recommended for public deployment)
# VIDEO_PROVIDER=heygen
# HEYGEN_API_KEY=your_heygen_api_key
# HEYGEN_AVATAR_ID=your_avatar_look_id
# HEYGEN_VOICE_ID=your_voice_id
# HEYGEN_API_BASE_URL=https://api.heygen.com
# HEYGEN_CREATE_MODE=v3_caption
# HEYGEN_AVATAR_ENGINE=avatar_iii
# HEYGEN_ENABLE_NATIVE_CAPTION=true
# HEYGEN_PROXY_URL=http://127.0.0.1:7897
# HEYGEN_REQUEST_TIMEOUT_MS=30000

# Post-processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PYTHON_PATH=python
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_MODE=faster_whisper
WHISPER_FALLBACK_ENABLED=true
